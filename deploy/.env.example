# Copy to deploy/.env and adjust values.
# docker compose (run from deploy/) reads .env automatically.
# gateway 通过 SUPEROPS_JWT_SECRET 环境变量覆盖 config/gateway.yaml 中的默认密钥（>=32 字符）。

MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=superops
MYSQL_USER=superops
MYSQL_PASSWORD=superops
CLICKHOUSE_DB=superops
CLICKHOUSE_USER=superops
CLICKHOUSE_PASSWORD=superops

# e-cat ecosystem (P0+)
KAFKA_BROKERS=localhost:9092
CONSUL_ADDR=http://localhost:8500
OTLP_ENDPOINT=http://localhost:4317
CH_URL=http://localhost:8124
PROMETHEUS_PORT=9095

# gateway 运行环境变量（参考，不在 compose 中生效）：
# SUPEROPS_JWT_SECRET=change-me-to-a-long-random-secret
# GATEWAY_CONFIG=../../config/gateway.yaml
# K8S_CONFIG=../../config/k8s-service.yaml
